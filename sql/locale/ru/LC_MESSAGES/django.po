#: sql/templates/sqlquery.html:185
msgid "Key操作"
msgstr "Операции с Key"

#: sql/templates/sqlquery.html:197
msgid "1、exists key　检查key是否存在，若key存在返回1，否则返回0"
msgstr "1. exists key — проверка наличия key (1/0)"

#: sql/templates/sqlquery.html:198
msgid "2、keys pattern 查找所有符合给定模式的key，通常用于查找key"
msgstr "2. keys pattern — поиск ключей по шаблону"

#: sql/templates/sqlquery.html:199
msgid "3、expire key seconds 为key设置超时时间（单位：秒），当key过期时，会被系统自动删除"
msgstr "3. expire key seconds — TTL в секундах; по истечении ключ удаляется"

#: sql/templates/sqlquery.html:200
msgid ""
"4、ttl key 以秒为单位返回key的剩余生存时间（time to live），当key不存在时返回-2，当key存在未设置生存时间时返回-1"
msgstr "4. ttl key — оставшийся TTL в секундах (-2 нет ключа, -1 без TTL)"

#: sql/templates/sqlquery.html:201
msgid "5、pttl key 这个命令和ttl类似，它以毫秒为单位返回key的剩余生存时间"
msgstr "5. pttl key — как ttl, но в миллисекундах"

#: sql/templates/sqlquery.html:202
msgid "6、move key db 将key移动到指定数据库中"
msgstr "6. move key db — переместить ключ в указанную БД"

#: sql/templates/sqlquery.html:203
msgid ""
"7、type key "
"返回key存储的值的类型，返回none（不存在）、string（字符串）、list（列表）、set（集合）、zset（有序集合）、hash（哈希表）"
msgstr "7. type key — тип значения: none/string/list/set/zset/hash"

#: sql/templates/sqlquery.html:207
msgid "1、get key 返回key的值，若key不存在则返回nil，若key存储的值不是字符串则返回错误"
msgstr "1. get key — значение ключа (nil если нет; ошибка если не string)"

#: sql/templates/sqlquery.html:208
msgid "2、mget key [key...] 依次返回一个或多个key的值，若key不存在返回nil，若key存在但不是字符串返回nil"
msgstr "2. mget key [key...] — значения нескольких ключей"

#: sql/templates/sqlquery.html:209
msgid "3、strlen key 返回key所存储的字符串的长度，当key不存在时返回0，当key存在但不是字符串时返回错误"
msgstr "3. strlen key — длина строки (0 если нет; ошибка если не string)"

#: sql/templates/sqlquery.html:210
msgid "4、append key value 将指定的值追加到key末尾，若key不存在，则创建并赋值，返回追加后的字符串长度"
msgstr "4. append key value — дописать значение; создаёт ключ при отсутствии"

#: sql/templates/sqlquery.html:211
msgid ""
"5、set key value [ex seconds] [px milliseconds] [nx|xx] "
"为key设置值,ex和px均为设置过期时间只不过单位不同，nx表示只有key不存在时才进行操作，xx表示只有key存在时才进行操作"
msgstr "5. set key value [ex|px] [nx|xx] — установить значение с опциями TTL и nx/xx"

#: sql/templates/sqlquery.html:212
msgid "6、setex key seconds value 设置带生存时间的key的值，以秒为单位"
msgstr "6. setex key seconds value — значение с TTL в секундах"

#: sql/templates/sqlquery.html:213
msgid "7、setnx key value 为key设置值，若key已存在则不进行任何操作"
msgstr "7. setnx key value — установить только если ключа нет"

#: sql/templates/sqlquery.html:214
msgid ""
"8、mset key value [key value...] 为一组或多组key设置值，该操作为原子操作，要么一组都设置成功，要么一组都设置失败"
msgstr "8. mset key value [...] — атомарная установка нескольких ключей"

#: sql/templates/sqlquery.html:215
msgid ""
"9、msetnx key value [key value...] 与mset不同的是msetnx中的key必须是不存在的，若有一个已存在则会整体失败"
msgstr "9. msetnx — как mset, но все ключи должны отсутствовать"

#: sql/templates/sqlquery.html:219
msgid "1、hgetall key 获取hash表中所有field的值"
msgstr "1. hgetall key — все поля hash"

#: sql/templates/sqlquery.html:220
msgid "2、hexists key field 判断hash表中指定field是否存在，返回1；若key或field不存在则返回0"
msgstr "2. hexists key field — есть ли поле (1/0)"

#: sql/templates/sqlquery.html:221
msgid "3、hget key field 获取hash表中指定field的值，key或field不存在时返回nil"
msgstr "3. hget key field — значение поля (nil если нет)"

#: sql/templates/sqlquery.html:222
msgid ""
"4、hmget key field[field...] 获取hash表中多个指定field的值，若key不存在返回空，若field不存在返回nil"
msgstr "4. hmget key field[...] — значения нескольких полей"

#: sql/templates/sqlquery.html:223
msgid "5、hkeys key 返回hash表中的所有field，若key不存在返回空"
msgstr "5. hkeys key — все имена полей"

#: sql/templates/sqlquery.html:224
msgid "6、hvals key 返回hash表中的所有val，若key不存在返回空"
msgstr "6. hvals key — все значения полей"

#: sql/templates/sqlquery.html:225
msgid "7、hdel key field[field...] 删除hash表中指定field，若key或field不存在则会忽略"
msgstr "7. hdel key field[...] — удалить поля"

#: sql/templates/sqlquery.html:226
msgid ""
"8、hset key field value 将field-"
"value设置到hash表中，若key不存在会新建hash表再赋值，若field已存在则会覆盖现有值"
msgstr "8. hset key field value — установить поле hash"

#: sql/templates/sqlquery.html:227
msgid "9、hsetnx key field value 和hset类似，但是hsetnx要求field不存在才能进行此操作，否则会返回0"
msgstr "9. hsetnx — как hset, только если поля ещё нет"

#: sql/templates/sqlquery.html:231
msgid "1、smembers key 列出集合key中的所有成员"
msgstr "1. smembers key — все элементы множества"

#: sql/templates/sqlquery.html:232
msgid "2、scard key 返回集合key中元素的个数"
msgstr "2. scard key — число элементов"

#: sql/templates/sqlquery.html:233
msgid "3、sdiff key[key...] 获取集合的差集，若key为1个则返回集合的全部成员"
msgstr "3. sdiff key[...] — разность множеств"

#: sql/templates/sqlquery.html:234
msgid "4、sunion key[key...] 返回集合的并集，不存在的key会被当做空集处理"
msgstr "4. sunion key[...] — объединение множеств"

#: sql/templates/sqlquery.html:235
msgid "5、spop key 移除并返回集合中的一个随机元素，当key不存在时返回NULL"
msgstr "5. spop key — удалить и вернуть случайный элемент"

#: sql/templates/sqlquery.html:236
msgid "6、sismember key member 判断member在key中是否已存在返回0或1"
msgstr "6. sismember key member — есть ли элемент (0/1)"

#: sql/templates/sqlquery.html:237
msgid ""
"7、sadd key member[member...] 将一个或多个member元素加入到集合key中，若member已存在那么会忽略此元素"
msgstr "7. sadd key member[...] — добавить элементы"

#: sql/templates/sqlquery.html:238
msgid ""
"8、smove source destination member "
"将元素member从source移动到destination；若member在destination中已存在只会删除source中的数据，若source或member不存在会返回0，若destination不存在则会创建后再进行操作"
msgstr "8. smove source destination member — переместить элемент между множествами"

#: sql/templates/sqlquery.html:239
msgid "9、srem key member[member]　移除key中的一个或多个member元素，不存在的member会被忽略"
msgstr "9. srem key member[...] — удалить элементы"

#: sql/templates/sqlquery.html:246
msgid "帮助文档："
msgstr "Справка:"

#: sql/templates/sqlquery.html:247
msgid "1、zrange key start stop [WITHSCORES] 通过索引区间返回有序集合指定区间内的成员"
msgstr "1. zrange key start stop [WITHSCORES] — элементы по индексу"

#: sql/templates/sqlquery.html:248
msgid "2、zrangebyscore key min max [WITHSCORES] [LIMIT] 通过分数返回有序集合指定区间内的成员"
msgstr "2. zrangebyscore key min max — элементы по score"

#: sql/templates/sqlquery.html:249
msgid "3、zscore key member 返回有序集中，成员的分数值"
msgstr "3. zscore key member — score элемента"

#: sql/templates/sqlquery.html:250
msgid "4、zcard key 获取有序集合的成员数"
msgstr "4. zcard key — число элементов"

#: sql/templates/sqlquery.html:251
msgid "5、zcount key min max 计算在有序集合中指定区间分数的成员数"
msgstr "5. zcount key min max — число элементов в диапазоне score"

#: sql/templates/sqlquery.html:252
msgid "6、zrank key member 返回有序集合中指定成员的索引"
msgstr "6. zrank key member — индекс элемента"

