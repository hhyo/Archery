#: sql/templates/sqlquery.html
msgid "帮助文档："
msgstr "Command reference:"

#: sql/templates/sqlquery.html
msgid "1、exists key 检查key是否存在，若key存在返回1，否则返回0"
msgstr "1. exists key: Returns 1 if the key exists, otherwise 0."

#: sql/templates/sqlquery.html
msgid "2、keys pattern 查找所有符合给定模式的key，通常用于查找key"
msgstr "2. keys pattern: Finds keys matching the pattern."

#: sql/templates/sqlquery.html
msgid "3、expire key seconds 为key设置超时时间（单位：秒），当key过期时，会被系统自动删除"
msgstr "3. expire key seconds: Sets an expiry in seconds; the key is removed after it expires."

#: sql/templates/sqlquery.html
msgid "4、ttl key 以秒为单位返回key的剩余生存时间（time to live），当key不存在时返回-2，当key存在未设置生存时间时返回-1"
msgstr "4. ttl key: Returns seconds to expiry, -2 for a missing key, or -1 for a key without an expiry."

#: sql/templates/sqlquery.html
msgid "5、pttl key 这个命令和ttl类似，它以毫秒为单位返回key的剩余生存时间"
msgstr "5. pttl key: Like TTL, but returns milliseconds."

#: sql/templates/sqlquery.html
msgid "6、move key db 将key移动到指定数据库中"
msgstr "6. move key db: Moves a key to another database."

#: sql/templates/sqlquery.html
msgid "7、type key 返回key存储的值的类型，返回none（不存在）、string（字符串）、list（列表）、set（集合）、zset（有序集合）、hash（哈希表）"
msgstr "7. type key: Returns none, string, list, set, zset or hash."

#: sql/templates/sqlquery.html
msgid "1、get key 返回key的值，若key不存在则返回nil，若key存储的值不是字符串则返回错误"
msgstr "1. get key: Returns the string value, nil for a missing key, or an error for a different type."

#: sql/templates/sqlquery.html
msgid "2、mget key [key...] 依次返回一个或多个key的值，若key不存在返回nil，若key存在但不是字符串返回nil"
msgstr "2. mget key [key...]: Returns values for multiple keys; missing or non-string values return nil."

#: sql/templates/sqlquery.html
msgid "3、strlen key 返回key所存储的字符串的长度，当key不存在时返回0，当key存在但不是字符串时返回错误"
msgstr "3. strlen key: Returns string length, 0 for a missing key, or an error for a different type."

#: sql/templates/sqlquery.html
msgid "4、append key value 将指定的值追加到key末尾，若key不存在，则创建并赋值，返回追加后的字符串长度"
msgstr "4. append key value: Appends a value, creating the key if needed, and returns the resulting length."

#: sql/templates/sqlquery.html
msgid "5、set key value [ex seconds] [px milliseconds] [nx|xx] 为key设置值,ex和px均为设置过期时间只不过单位不同，nx表示只有key不存在时才进行操作，xx表示只有key存在时才进行操作"
msgstr "5. set key value [ex seconds] [px milliseconds] [nx|xx]: Sets a value; EX and PX specify expiry, NX requires a missing key, and XX requires an existing key."

#: sql/templates/sqlquery.html
msgid "6、setex key seconds value 设置带生存时间的key的值，以秒为单位"
msgstr "6. setex key seconds value: Sets a value with an expiry in seconds."

#: sql/templates/sqlquery.html
msgid "7、setnx key value 为key设置值，若key已存在则不进行任何操作"
msgstr "7. setnx key value: Sets a value only when the key does not exist."

#: sql/templates/sqlquery.html
msgid "8、mset key value [key value...] 为一组或多组key设置值，该操作为原子操作，要么一组都设置成功，要么一组都设置失败"
msgstr "8. mset key value [key value...]: Sets multiple key/value pairs atomically."

#: sql/templates/sqlquery.html
msgid "9、msetnx key value [key value...] 与mset不同的是msetnx中的key必须是不存在的，若有一个已存在则会整体失败"
msgstr "9. msetnx key value [key value...]: Sets all pairs only when none of the keys already exist."

#: sql/templates/sqlquery.html
msgid "1、hgetall key 获取hash表中所有field的值"
msgstr "1. hgetall key: Returns all fields and values in the hash."

#: sql/templates/sqlquery.html
msgid "2、hexists key field 判断hash表中指定field是否存在，返回1；若key或field不存在则返回0"
msgstr "2. hexists key field: Returns 1 when the field exists, otherwise 0."

#: sql/templates/sqlquery.html
msgid "3、hget key field 获取hash表中指定field的值，key或field不存在时返回nil"
msgstr "3. hget key field: Returns the field value, or nil when the key or field is missing."

#: sql/templates/sqlquery.html
msgid "4、hmget key field[field...] 获取hash表中多个指定field的值，若key不存在返回空，若field不存在返回nil"
msgstr "4. hmget key field[field...]: Returns the requested field values, with nil for missing fields."

#: sql/templates/sqlquery.html
msgid "5、hkeys key 返回hash表中的所有field，若key不存在返回空"
msgstr "5. hkeys key: Returns all field names, or an empty result for a missing key."

#: sql/templates/sqlquery.html
msgid "6、hvals key 返回hash表中的所有val，若key不存在返回空"
msgstr "6. hvals key: Returns all values, or an empty result for a missing key."

#: sql/templates/sqlquery.html
msgid "7、hdel key field[field...] 删除hash表中指定field，若key或field不存在则会忽略"
msgstr "7. hdel key field[field...]: Deletes fields; missing keys or fields are ignored."

#: sql/templates/sqlquery.html
msgid "8、hset key field value 将field-value设置到hash表中，若key不存在会新建hash表再赋值，若field已存在则会覆盖现有值"
msgstr "8. hset key field value: Sets a field value, creating the hash if necessary and replacing an existing value."

#: sql/templates/sqlquery.html
msgid "9、hsetnx key field value 和hset类似，但是hsetnx要求field不存在才能进行此操作，否则会返回0"
msgstr "9. hsetnx key field value: Sets a field only if it does not already exist."

#: sql/templates/sqlquery.html
msgid "1、smembers key 列出集合key中的所有成员"
msgstr "1. smembers key: Returns all members of the set."

#: sql/templates/sqlquery.html
msgid "2、scard key 返回集合key中元素的个数"
msgstr "2. scard key: Returns the number of members."

#: sql/templates/sqlquery.html
msgid "3、sdiff key[key...] 获取集合的差集，若key为1个则返回集合的全部成员"
msgstr "3. sdiff key[key...]: Returns the difference between sets; one key returns all its members."

#: sql/templates/sqlquery.html
msgid "4、sunion key[key...] 返回集合的并集，不存在的key会被当做空集处理"
msgstr "4. sunion key[key...]: Returns the union of sets, treating missing keys as empty sets."

#: sql/templates/sqlquery.html
msgid "5、spop key 移除并返回集合中的一个随机元素，当key不存在时返回NULL"
msgstr "5. spop key: Removes and returns a random member, or NULL for a missing key."

#: sql/templates/sqlquery.html
msgid "6、sismember key member 判断member在key中是否已存在返回0或1"
msgstr "6. sismember key member: Returns 1 if the member exists, otherwise 0."

#: sql/templates/sqlquery.html
msgid "7、sadd key member[member...] 将一个或多个member元素加入到集合key中，若member已存在那么会忽略此元素"
msgstr "7. sadd key member[member...]: Adds members, ignoring duplicates."

#: sql/templates/sqlquery.html
msgid "8、smove source destination member 将元素member从source移动到destination；若member在destination中已存在只会删除source中的数据，若source或member不存在会返回0，若destination不存在则会创建后再进行操作"
msgstr "8. smove source destination member: Moves a member between sets, creating the destination if needed. Returns 0 if the source or member is missing."

#: sql/templates/sqlquery.html
msgid "9、srem key member[member] 移除key中的一个或多个member元素，不存在的member会被忽略"
msgstr "9. srem key member[member]: Removes members, ignoring missing members."

#: sql/templates/sqlquery.html
msgid "1、zrange key start stop [WITHSCORES] 通过索引区间返回有序集合指定区间内的成员"
msgstr "1. zrange key start stop [WITHSCORES]: Returns members within an index range."

#: sql/templates/sqlquery.html
msgid "2、zrangebyscore key min max [WITHSCORES] [LIMIT] 通过分数返回有序集合指定区间内的成员"
msgstr "2. zrangebyscore key min max [WITHSCORES] [LIMIT]: Returns members within a score range."

#: sql/templates/sqlquery.html
msgid "3、zscore key member 返回有序集中，成员的分数值"
msgstr "3. zscore key member: Returns the score of a member."

#: sql/templates/sqlquery.html
msgid "4、zcard key 获取有序集合的成员数"
msgstr "4. zcard key: Returns the number of members."

#: sql/templates/sqlquery.html
msgid "5、zcount key min max 计算在有序集合中指定区间分数的成员数"
msgstr "5. zcount key min max: Counts members within a score range."

#: sql/templates/sqlquery.html
msgid "6、zrank key member 返回有序集合中指定成员的索引"
msgstr "6. zrank key member: Returns the rank of a member."

